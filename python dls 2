n=int(input("enter the number of coustmer accounts IDS:"))
account_ids=[]

for i in range (n):
    account_ids.append=int(input("enter account ID"))

key=int(input("enter the account id to search "))



found = False
for i in range(n):
    if account_ids[i] == key:
        print("Linear Search: Account ID found at index", i)
        found = True
        break

if not found:
    print("Linear Search: Account ID not found")
account_ids.sort()

low = 0
high = len(account_ids) - 1
found = False

while low <= high:
    mid = (low + high) // 2

    if account_ids[mid] == key:
        print("Binary Search: Account ID found at index", mid)
        found = True
        break
    elif account_ids[mid] < key:
        low = mid + 1
    else:
        high = mid - 1

if not found:
    print("Binary Search: Account ID not found")
